server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    access_log /var/log/nginx/local_flavor.access.log;
    error_log /var/log/nginx/local_flavor.error.log warn;
    client_max_body_size 20m;

    location /django-static/ {
        alias __LOCAL_FLAVOR_DJANGO_STATIC_DIR__/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /static/ {
        alias __LOCAL_FLAVOR_MEDIA_DIR__/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:__LOCAL_FLAVOR_API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }

    location /django/api/v1/ {
        proxy_pass http://127.0.0.1:__LOCAL_FLAVOR_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /django/admin/ {
        proxy_pass http://127.0.0.1:__LOCAL_FLAVOR_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:__LOCAL_FLAVOR_FRONTEND_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
