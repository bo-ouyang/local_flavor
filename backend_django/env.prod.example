# Non-secret production configuration. Copy this file to env.prod on the host.
# Secrets belong in env.prod.secrets, which is never committed.
DJANGO_ENV=pro
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_SERVER_PUBLIC_IP
LOCAL_FLAVOR_PUBLIC_HOST=REPLACE_WITH_SERVER_PUBLIC_IP

# Docker connects to the pre-existing host PostgreSQL via host-gateway.
DB_ENGINE=postgres
DB_NAME=local_flavor
DB_USER=local_flavor_user
DB_HOST=host.docker.internal
DB_PORT=5432

AUTH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_LAST_SEEN_INTERVAL_SECONDS=300
AUTH_LEGACY_MAX_WINDOW_SECONDS=7776000
AUTH_LEGACY_TOKEN_ENABLED=0
AUTH_LEGACY_TOKEN_ACCEPT_UNTIL=
AUTH_WS_QUERY_TOKEN_ENABLED=0

WECHAT_API_TIMEOUT_SECONDS=8
UPLOAD_MAX_FILE_MB=5
UPLOAD_IMAGE_MAX_WIDTH=1280
UPLOAD_IMAGE_MAX_HEIGHT=1280
UPLOAD_IMAGE_JPEG_QUALITY=85
UPLOAD_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
COMMENT_MAX_DEPTH=8

CACHE_BACKEND=redis
CACHE_DEFAULT_TTL=300
CACHE_TTL_OPTIONS=3600
CACHE_TTL_ITEMS_LIST=60
CACHE_TTL_ITEM_DETAIL=60
CACHE_TTL_ITEMS_TODAY=120
CACHE_TTL_COMMENTS=30
CACHE_TTL_STATS_MAP=300
CACHE_TTL_STATS_MAP_DATA=86400
CACHE_REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=local_flavor

CHAT_ENABLE_WS=1
CHAT_REDIS_URL=redis://redis:6379/1
CHAT_WS_HEARTBEAT_SECONDS=30

CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_TIME_LIMIT=300

COMMUNITY_AUDIT_BANNED_WORDS=
ITEM_AUDIT_BANNED_WORDS=
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=
