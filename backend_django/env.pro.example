# Copy to env.pro and replace every required blank value before deployment.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
DJANGO_SECRET_KEY=

DB_ENGINE=postgres
DB_NAME=local_flavor
DB_USER=local_flavor_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

AUTH_TOKEN_TTL_SECONDS=2592000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_LAST_SEEN_INTERVAL_SECONDS=300
AUTH_LEGACY_MAX_WINDOW_SECONDS=7776000
# AUTH-01A migration deployment: both switches are intentionally explicit.
# Replace the invalid placeholder with an aware UTC cutoff no more than 90 days
# in the future. Copying this file without editing the cutoff must fail startup.
AUTH_LEGACY_TOKEN_ENABLED=1
AUTH_LEGACY_TOKEN_ACCEPT_UNTIL=REPLACE_WITH_UTC_CUTOFF_WITHIN_90_DAYS
AUTH_WS_QUERY_TOKEN_ENABLED=1

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_API_TIMEOUT_SECONDS=8

UPLOAD_MAX_FILE_MB=5
UPLOAD_IMAGE_MAX_WIDTH=1280
UPLOAD_IMAGE_MAX_HEIGHT=1280
UPLOAD_IMAGE_JPEG_QUALITY=85
UPLOAD_ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
COMMENT_MAX_DEPTH=8

CACHE_BACKEND=redis
CACHE_DEFAULT_TTL=300
CACHE_TTL_OPTIONS=3600
CACHE_TTL_ITEMS_LIST=60
CACHE_TTL_ITEM_DETAIL=60
CACHE_TTL_ITEMS_TODAY=120
CACHE_TTL_COMMENTS=30
CACHE_TTL_STATS_MAP=300
CACHE_TTL_STATS_MAP_DATA=86400
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=local_flavor

CHAT_ENABLE_WS=1
CHAT_REDIS_URL=redis://127.0.0.1:6379/1
CHAT_WS_HEARTBEAT_SECONDS=30

CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_TIME_LIMIT=300

COMMUNITY_AUDIT_BANNED_WORDS=
ITEM_AUDIT_BANNED_WORDS=
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=
